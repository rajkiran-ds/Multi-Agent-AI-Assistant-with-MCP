# -----------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file to GitHub.
# -----------------------------------------------------------------------

# Which LLM backend to use: groq | openai | ollama
LLM_PROVIDER=groq

# --- Groq (recommended: free tier, works on Streamlit Cloud) -----------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (optional alternative) --------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (optional, LOCAL DEV ONLY - will not work on Streamlit Cloud)
OLLAMA_MODEL=llama3.1

# --- Real email sending (SMTP) ------------------------------------------
# Gmail example: use an App Password, NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account)
EMAIL_ADDRESS=your_email@example.com
EMAIL_APP_PASSWORD=your_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
